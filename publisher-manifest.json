\"\";display: inline-block;width: 6px;height: 6px;background: var(--accent)}\n\n    /* ---------- 通用区块 ---------- */\n    .section {margin-bottom: 72px;scroll-margin-top: 24px}\n\n    .section__kicker {font-size: 11px;letter-spacing: 0.24em;color: var(--accent-deep);font-weight: 700;margin: 0 0 6px}\n\n    .section h2 {font-size: clamp(24px, 3.4vw, 34px);margin: 0 0 8px}\n\n    .section__intro {max-width: 46em;color: var(--ink-soft);margin: 0 0 32px;font-size: 15px}\n\n    /* ---------- 粗描边直角卡片（通用） ---------- */\n    .card {background: var(--panel);border: 2px solid var(--line);padding: 26px 28px}\n\n    /* ---------- 使用说明 ---------- */\n    .steps {display: grid;grid-template-columns: repeat(3, 1fr);gap: var(--gap)}\n\n    .step-card {background: var(--panel);border: 2px solid var(--line);padding: 24px 22px;display: flex;flex-direction: column;gap: 10px}\n\n    .step-card__num {font-size: 40px;font-weight: 800;line-height: 1;color: var(--accent);letter-spacing: -0.02em}\n\n    .step-card h3 {font-size: 17px;margin: 0}\n\n    .step-card p {font-size: 14px;color: var(--ink-soft);margin: 0}\n\n    /* ---------- 套餐：单列大卡依次堆叠 ---------- */\n    .plans {display: flex;flex-direction: column;gap: var(--gap)}\n\n    .plan {background: var(--panel);border: 2px solid var(--line);padding: 28px 30px;display: grid;grid-template-columns: 1.1fr 1fr;gap: 24px 40px;align-items: start;position: relative}\n\n    .plan--featured {border-color: var(--accent);box-shadow: 8px 8px 0 0 var(--accent-soft)}\n\n    .plan__flag {display: inline-block;background: var(--accent);color: #ffffff;font-size: 11px;font-weight: 700;letter-spacing: 0.16em;padding: 3px 10px;margin-bottom: 12px}\n\n    .plan__name {font-size: 22px;margin: 0 0 4px}\n\n    .plan__desc {font-size: 14px;color: var(--ink-soft);margin: 0 0 18px}\n\n    .plan__price {display: flex;flex-wrap: wrap;align-items: baseline;gap: 10px;margin-bottom: 4px}\n\n    .plan__amount {font-size: 32px;font-weight: 800;letter-spacing: -0.01em}\n\n    .plan__amount small {font-size: 14px;font-weight: 500;color: var(--ink-faint);margin-left: 2px}\n\n    .plan__annual {font-size: 13px;color: var(--accent-deep);font-weight: 600;margin: 0}\n\n    .plan__features {display: flex;flex-direction: column;gap: 8px;font-size: 14px;color: var(--ink-soft);border-left: 2px solid var(--accent-soft);padding-left: 24px}\n\n    .plan__features li {position: relative;padding-left: 16px}\n\n    .plan__features li::before {content: \"\";position: absolute;left: 0;top: 10px;width: 7px;height: 7px;background: var(--accent)}\n\n    .plans-note {margin-top: 20px;font-size: 13px;color: var(--ink-faint);max-width: 52em}\n\n    /* ---------- 客户端 ---------- */\n    .clients-grid {display: grid;grid-template-columns: repeat(2, 1fr);gap: var(--gap)}\n\n    .client-card {background: var(--panel);border: 2px solid var(--line);padding: 24px 26px}\n\n    .client-card h3 {font-size: 17px;margin: 0 0 8px;display: flex;align-items: center;gap: 10px}\n\n    .client-card h3 span {font-size: 11px;font-weight: 700;letter-spacing: 0.14em;color: var(--accent-deep);background: var(--accent-soft);padding: 2px 8px;white-space: nowrap}\n\n    .client-card p {font-size: 14px;color: var(--ink-soft);margin: 0 0 12px}\n\n    .client-card ul {display: flex;flex-direction: column;gap: 6px;font-size: 13px;color: var(--ink-soft)}\n\n    .client-card li {position: relative;padding-left: 16px}\n\n    .client-card li::before {content: \"\";position: absolute;left: 0;top: 9px;width: 6px;height: 6px;background: var(--accent)}\n\n    .client-card__foot {margin-top: 16px;padding-top: 12px;border-top: 1px dashed #c9cad2;font-size: 12px;color: var(--ink-faint)}\n\n    /* ---------- FAQ details 折叠 ---------- */\n    .faq {display: flex;flex-direction: column;gap: 12px}\n\n    .faq details {background: var(--panel);border: 2px solid var(--line);padding: 0}\n\n    .faq summary {cursor: pointer;list-style: none;display: flex;align-items: flex-start;gap: 12px;padding: 18px 22px;font-size: 15px;font-weight: 700;color: var(--ink)}\n\n    .faq summary::-webkit-details-marker {display: none}\n\n    .faq summary::before {content: \"+\";flex: 0 0 auto;width: 22px;text-align: center;font-size: 20px;line-height: 1.2;font-weight: 800;color: var(--accent)}\n\n    .faq details[open] summary::before {content: \"−\"}\n\n    .faq details[open] summary {background: var(--accent-soft)}\n\n    .faq__answer {padding: 4px 22px 20px 56px;font-size: 14px;color: var(--ink-soft)}\n\n    .faq__answer p {margin: 0 0 0.8em}\n\n    .faq__answer p:last-child {margin-bottom: 0}\n\n    .faq-note {margin-top: 20px;font-size: 13px;color: var(--ink-faint);max-width: 52em}\n\n    /* ---------- 页脚 ---------- */\n    .footer {border-top: 2px solid var(--line);padding-top: 24px;font-size: 13px;color: var(--ink-faint);display: flex;flex-wrap: wrap;justify-content: space-between;gap: 12px 24px}\n\n    .footer a {color: var(--ink-soft)}\n\n    /* ---------- 响应式 ---------- */\n    @media (max-width: 940px) {.layout {\n        flex-direction: column;}\n\n      .sidebar {\n        position: static;width: 100%;flex-basis: auto;height: auto;border-right: none;border-bottom: 2px solid var(--line);padding: 22px 24px 18px;}\n\n      .sidebar__tag {\n        margin-bottom: 18px;}\n\n      .sidebar__label {\n        margin-top: 6px;}\n\n      .sidebar__nav ul {\n        flex-direction: row;flex-wrap: wrap;gap: 6px;}\n\n      .sidebar__nav a {\n        border-left: none;border-bottom: 2px solid transparent;padding: 4px 8px;}\n\n      .sidebar__nav a:hover,\n      .sidebar__nav a:focus-visible {\n        border-left-color: transparent;border-bottom-color: var(--accent);}\n\n      .sidebar__note {\n        margin-top: 16px;padding-top: 12px;}\n\n      .main {\n        padding: 32px 24px 56px;}\n\n      .dashboard {\n        grid-template-columns: repeat(2, 1fr);}\n\n      .dash-block--wide {\n        grid-column: span 2;}\n\n      .steps {\n        grid-template-columns: 1fr;}\n\n      .plan {\n        grid-template-columns: 1fr;gap: 20px;}\n\n      .plan__features {\n        border-left: none;padding-left: 0;border-top: 1px solid #e1e2e8;padding-top: 16px;}\n\n      .clients-grid {\n        grid-template-columns: 1fr;}}\n\n    @media (max-width: 560px) {\n      .dashboard {grid-template-columns: 1fr}\n\n      .dash-block--wide {grid-column: span 1}\n\n      .hero h1 {font-size: 32px}\n\n      .main {padding: 24px 18px 48px}\n\n      .faq__answer {padding-left: 22px}\n\n      .plan {padding: 22px 20px}\n    }\n  </style><div class=\"layout\">\n\n    <aside class=\"sidebar\">\n      <a class=\"sidebar__brand\" href=\"#top\">绵羊云</a>\n      <p class=\"sidebar__tag\">SHEEP CLOUD</p>\n      <p class=\"sidebar__label\">目录</p>\n      <nav class=\"sidebar__nav\" aria-label=\"页面目录\">\n        <ul>\n          <li><a href=\"#top\">首页概览</a></li>\n          <li><a href=\"#guide\">三步入网</a></li>\n          <li><a href=\"#plans\">订阅方案</a></li>\n          <li><a href=\"#clients\">客户端</a></li>\n          <li><a href=\"#faq\">常见问题</a></li>\n        </ul>\n      </nav>\n      <div class=\"sidebar__note\">\n        这是一份安静的说明页。慢慢看，按自己的节奏来选。\n      </div>\n    </aside>\n\n    <main class=\"main\" id=\"top\">\n\n      \n      <header class=\"hero\">\n        <div class=\"hero__head\">\n          <p class=\"hero__eyebrow\">绵羊云 · 接入方案</p>\n        </div>\n        <h1>绵羊云：把网络接入这件事，说清楚再选</h1>\n        <p class=\"hero__lede\">\n          我们不急着推荐贵的，也不爱堆形容词。下面这几块信息拼在一起，大概就是绵羊云的全貌：能做什么、怎么开始、花多少钱、遇到问题找谁。看完再决定也不迟。\n        </p>\n\n        <div class=\"dashboard\">\n          <div class=\"dash-block\">\n            <p class=\"dash-block__label\">起步门槛</p>\n            <p class=\"dash-block__big\">¥15<span> / 月起</span></p>\n            <p class=\"dash-block__sub\">基础版按月订阅</p>\n          </div>\n          <div class=\"dash-block\">\n            <p class=\"dash-block__label\">流量档位</p>\n            <p class=\"dash-block__big\">100 GB 起</p>\n            <p class=\"dash-block__sub\">按月计算，可随时查看余量</p>\n          </div>\n          <div class=\"dash-block dash-block--accent\">\n            <p class=\"dash-block__label\">年付参考</p>\n            <p class=\"dash-block__big\">¥150 起</p>\n            <p class=\"dash-block__sub\">按年付的折算价格</p>\n          </div>\n          <div class=\"dash-block\">\n            <p class=\"dash-block__label\">设备数</p>\n            <p class=\"dash-block__big\">3 台起</p>\n            <p class=\"dash-block__sub\">可同时在线，按方案递增</p>\n          </div>\n\n          <div class=\"dash-block dash-block--wide\">\n            <p class=\"dash-block__label\">方案一览</p>\n            <ul class=\"dash-block__list\">\n              <li>基础版 100GB / 3 设备</li>\n              <li>旗舰版 300GB / 5 设备</li>\n              <li>团队版 1000GB / 20 设备</li>\n            </ul>\n          </div>\n\n          <div class=\"dash-block dash-block--wide\">\n            <p class=\"dash-block__label\">我们习惯这样沟通</p>\n            <ul class=\"dash-block__list\">\n              <li>工单回复不绕弯子</li>\n              <li>价格和额度写在明面上</li>\n              <li>教程按步骤拆开讲</li>\n            </ul>\n          </div>\n        </div>\n      </header>\n\n      \n      <section class=\"section\" id=\"guide\">\n        <p class=\"section__kicker\">使用说明</p>\n        <h2>三步入网，不绕远路</h2>\n        <p class=\"section__intro\">\n          不需要研究太久。先把这几个动作做完，后面用起来就顺了。如果哪一步卡住，页面底部的常见问题里大概有答案。\n        </p>\n\n        <div class=\"steps\">\n          <article class=\"step-card\">\n            <p class=\"step-card__num\">01</p>\n            <h3>先挑一个方案，不必一步到位</h3>\n            <p>\n              从基础版开始完全没问题。流量用超了或者设备数不够，再往上升一档也来得及，不用一上来就买最贵的。\n            </p>\n          </article>\n\n          <article class=\"step-card\">\n            <p class=\"step-card__num\">02</p>\n            <h3>在客户端里填入配置信息</h3>\n            <p>\n              打开你常用的客户端，按页面提供的配置说明填写。不懂参数也没关系，跟着教程一步步来，填完保存即可。\n            </p>\n          </article>\n\n          <article class=\"step-card\">\n            <p class=\"step-card__num\">03</p>\n            <h3>连上之后，先做一次小范围测试</h3>\n            <p>\n              别急着把全部设备都挂上去。先拿一台设备验证能正常访问，确认没问题后再添加其他设备，这样排查起来更简单。\n            </p>\n          </article>\n        </div>\n      </section>\n\n      \n      <section class=\"section\" id=\"plans\">\n        <p class=\"section__kicker\">订阅方案</p>\n        <h2>三档方案，排成一列看清楚</h2>\n        <p class=\"section__intro\">\n          价格、流量和同时在线设备数都摆在这儿了。我们不隐藏条款，也不会在额度上做模糊处理。按年付的价格只在下方标注，具体以实际结算为准。\n        </p>\n\n        <div class=\"plans\">\n          <article class=\"plan\">\n            <div class=\"plan__summary\">\n              <h3 class=\"plan__name\">基础版</h3>\n              <p class=\"plan__desc\">适合刚开始用、设备不多的情况。先熟悉流程，再决定要不要加量。</p>\n              <div class=\"plan__price\">\n                <span class=\"plan__amount\">¥15<small> / 月</small></span>\n              </div>\n              <p class=\"plan__annual\">按年付仅需 ¥150 / 年</p>\n            </div>\n            <ul class=\"plan__features\">\n              <li>每月 100GB 极速流量</li>\n              <li>支持 3 台设备同时在线</li>\n              <li>解锁基础流媒体</li>\n              <li>普通线路节点池</li>\n            </ul>\n          </article>\n\n          <article class=\"plan plan--featured\">\n            <div class=\"plan__summary\">\n              <span class=\"plan__flag\">推荐给多人家庭</span>\n              <h3 class=\"plan__name\">旗舰版</h3>\n              <p class=\"plan__desc\">流量和设备数都宽裕一些，适合日常多设备一起用，也照顾到对线路质量有要求的人。</p>\n              <div class=\"plan__price\">\n                <span class=\"plan__amount\">¥35<small> / 月</small></span>\n              </div>\n              <p class=\"plan__annual\">按年付仅需 ¥350 / 年</p>\n            </div>\n            <ul class=\"plan__features\">\n              <li>每月 300GB 极速流量</li>\n              <li>支持 5 台设备同时在线</li>\n              <li>全节点原生流媒体解锁</li>\n              <li>IPLC 专线游戏加速优化</li>\n              <li>7x24 优先工单支持</li>\n            </ul>\n          </article>\n\n          <article class=\"plan\">\n            <div class=\"plan__summary\">\n              <h3 class=\"plan__name\">团队版</h3>\n              <p class=\"plan__desc\">给小团队或者设备很多的人准备的。带宽和在线数量都往上抬了一档，还能聊定制路由。</p>\n              <div class=\"plan__price\">\n                <span class=\"plan__amount\">¥85<small> / 月</small></span>\n              </div>\n              <p class=\"plan__annual\">按年付仅需 ¥850 / 年</p>\n            </div>\n            <ul class=\"plan__features\">\n              <li>每月 1000GB 极速流量</li>\n              <li>支持 20 台设备同时在线</li>\n              <li>VIP 专属高带宽节点</li>\n              <li>支持企业定制路由</li>\n              <li>专属客户经理服务</li>\n            </ul>\n          </article>\n        </div>\n\n        <p class=\"plans-note\">\n          价格与权益以上方卡片写明的为准。如果之后有调整，会在这里同步更新，不会让你在付款页才发现变化。\n        </p>\n      </section>\n\n      \n      <section class=\"section\" id=\"clients\">\n        <p class=\"section__kicker\">客户端</p>\n        <h2>常用客户端，按你顺手的来</h2>\n        <p class=\"section__intro\">\n          我们不会只说“支持所有客户端”。下面挑了几类常见的使用场景，看看哪个更接近你的习惯。下载地址请以各客户端官方页面为准。\n        </p>\n\n        <div class=\"clients-grid\">\n          <article class=\"client-card\">\n            <h3>桌面端 <span>适合固定办公</span></h3>\n            <p>在电脑上长时间挂着，需要稳定和方便切换的场景。</p>\n            <ul>\n              <li>按客户端指引导入配置信息</li>\n              <li>建议先测试一条线路再切换其他线路</li>\n              <li>多设备用户可以在同一方案下管理自己的设备</li>\n            </ul>\n            <p class=\"client-card__foot\">下载与安装请前往对应客户端的官方发布页面。</p>\n          </article>\n\n          <article class=\"client-card\">\n            <h3>移动端 <span>适合随身使用</span></h3>\n            <p>手机上临时打开、出门在外的场景，配置过程尽量简化。</p>\n            <ul>\n              <li>按教程逐步完成配置</li>\n              <li>注意同时在线设备数按方案计算</li>\n              <li>切换网络环境后建议重新确认连接状态</li>\n            </ul>\n            <p class=\"client-card__foot\">系统与应用商店的版本差异较大，请以客户端说明为准。</p>\n          </article>\n\n          <article class=\"client-card\">\n            <h3>路由器 <span>适合全屋覆盖</span></h3>\n            <p>希望家里多台设备一起接入时，路由器方式会省心一些。</p>\n            <ul>\n              <li>需要路由器本身支持配置导入</li>\n              <li>配置前先确认方案中的设备数上限</li>\n              <li>出问题时先回退到单设备试连排查</li>\n            </ul>\n            <p class=\"client-card__foot\">不同路由器固件的操作方式不同，请参考设备自身的说明。</p>\n          </article>\n\n          <article class=\"client-card\">\n            <h3>工单与支持 <span>遇到问题随时找</span></h3>\n            <p>配置没通、流量对不上、设备数有疑问，都可以开一条工单。</p>\n            <ul>\n              <li>工单里写清楚设备类型和现象</li>\n              <li>优先工单是旗舰版及以上方案的权益</li>\n              <li>回复时会尽量给出可以自己验证的步骤</li>\n            </ul>\n            <p class=\"client-card__foot\">支持入口以页面内提供的工单通道为准。</p>\n          </article>\n        </div>\n      </section>\n\n      \n      <section class=\"section\" id=\"faq\">\n        <p class=\"section__kicker\">常见问题</p>\n        <h2>问得最多的几个问题</h2>\n        <p class=\"section__intro\">\n          答案都写在这里了，不用去翻别的地方。点开看就行，没找到的再开工单聊。\n        </p>\n\n        <div class=\"faq\">\n          <details>\n            <summary>第一次用，应该选哪个方案？</summary>\n            <div class=\"faq__answer\">\n              <p>大部分情况下从基础版开始就好。每月 100GB 流量、3 台设备同时在线，足够先熟悉整个流程。等发现流量不够或者设备加不上时，再升级到旗舰版或团队版。</p>\n            </div>\n          </details>\n\n          <details>\n            <summary>年付价格和月付价格是什么关系？</summary>\n            <div class=\"faq__answer\">\n              <p>卡片上标注的年付价格是按年一次性支付的总价，并非在月付基础上打折的会员价。基础版按年付为 ¥150/年，旗舰版为 ¥350/年，团队版为 ¥850/年。具体以实际结算页面显示为准。</p>\n            </div>\n          </details>\n\n          <details>\n            <summary>设备数是怎么算的？手机和电脑算一台还是两台？</summary>\n            <div class=\"faq__answer\">\n              <p>按同时在线设备计算。手机、电脑、平板各算一台。如果某个设备断开连接，名额就空出来了。旗舰版支持 5 台同时在线，团队版支持 20 台，超出这个数就需要等有设备下线。</p>\n            </div>\n          </details>\n\n          <details>\n            <summary>流量用完了会怎样，能不能临时加量？</summary>\n            <div class=\"faq__answer\">\n              <p>当月的流量额度用完后，需要等到下个计费周期恢复，或者调整到更高档位的方案。目前没有单独购买流量包的入口，所以建议先看一下自己的使用习惯，再选额度合适的方案。</p>\n            </div>\n          </details>\n\n          <details>\n            <summary>配置导入失败，一般先检查哪里？</summary>\n            <div class=\"faq__answer\">\n              <p>先确认配置信息是否完整复制、有没有多余的空格或换行。然后确认客户端版本是否过旧。如果还是不通，把设备类型、客户端名称和报错提示写进工单，会更快定位问题。</p>\n            </div>\n          </details>\n\n          <details>\n            <summary>支持哪些客户端？会不会有兼容性问题？</summary>\n            <div class=\"faq__answer\">\n              <p>页面里列出的场景覆盖桌面端、移动端和路由器三类。不同系统的客户端更新节奏不同，偶尔会遇到界面变化或者配置方式调整。遇到这种情况，以客户端自身的说明为准，也可以开工单问我们。</p>\n            </div>\n          </details>\n        </div>\n\n        <p class=\"faq-note\">\n          这里没有列出来的问题，也可以通过工单联系。我们更愿意把话说清楚，而不是让你猜。\n        </p>\n      </section>\n\n      <footer class=\"footer\">\n        <span>绵羊云 · 一份把话说清楚的接入说明页</span>\n        <span>内容以页面展示为准 · <a href=\"#top\">回到顶部</a></span>\n      </footer>\n\n    </main>\n  </div>",
